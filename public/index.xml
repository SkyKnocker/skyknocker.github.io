tyle=&#34;margin-bottom: 10px;&#34;&gt;&#xA;      &lt;a href=&#34;http://localhost:1313/uploads/LinkedIn_Learning/CertificateOfCompletion_Project%20Management%20Foundations%20Quality.pdf&#34; target=&#34;_blank&#34; style=&#34;text-decoration: none;&#34;&gt;&#xA;        📜 Project Management Foundations Quality&#xA;      &lt;/a&gt;&#xA;    &lt;/li&gt;&#xA;  &#xA;&#xA;  &#xA;    &lt;li style=&#34;margin-bottom: 10px;&#34;&gt;&#xA;      &lt;a href=&#34;http://localhost:1313/uploads/LinkedIn_Learning/CertificateOfCompletion_Project%20Management%20Foundations%20Small%20Projects.pdf&#34; target=&#34;_blank&#34; style=&#34;text-decoration: none;&#34;&gt;&#xA;        📜 Project Management Foundations Small Projects&#xA;      &lt;/a&gt;&#xA;    &lt;/li&gt;&#xA;  &#xA;&#xA;  &#xA;    &lt;li style=&#34;margin-bottom: 10px;&#34;&gt;&#xA;      &lt;a href=&#34;http://localhost:1313/uploads/LinkedIn_Learning/CertificateOfCompletion_Project%20Management%20Preventing%20Scope%20Creep.pdf&#34; target=&#34;_blank&#34; style=&#34;text-decoration: none;&#34;&gt;&#xA;        📜 Project Management Preventing Scope Creep&#xA;      &lt;/a&gt;&#xA;    &lt;/li&gt;&#xA;  &#xA;&#xA;  &#xA;    &lt;li style=&#34;margin-bottom: 10px;&#34;&gt;&#xA;      &lt;a href=&#34;http://localhost:1313/uploads/LinkedIn_Learning/CertificateOfCompletion_Project%20Management%20Solving%20Common%20Project%20Problems.pdf&#34; target=&#34;_blank&#34; style=&#34;text-decoration: none;&#34;&gt;&#xA;        📜 Project Management Solving Common Project Problems&#xA;      &lt;/a&gt;&#xA;    &lt;/li&gt;&#xA;  &#xA;&#xA;  &#xA;    &lt;li style=&#34;margin-bottom: 10px;&#34;&gt;&#xA;      &lt;a href=&#34;http://localhost:1313/uploads/LinkedIn_Learning/CertificateOfCompletion_Python%20Quick%20Start%202019.pdf&#34; target=&#34;_blank&#34; style=&#34;text-decoration: none;&#34;&gt;&#xA;        📜 Python Quick Start 2019&#xA;      &lt;/a&gt;&#xA;    &lt;/li&gt;&#xA;  &#xA;&#xA;  &#xA;    &lt;li style=&#34;margin-bottom: 10px;&#34;&gt